{
  "buildCommand": "",
  "outputDirectory": "build",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/s/:code",
      "destination": "https://app.imonsocial.com/api/s/:code",
      "permanent": false
    },
    {
      "source": "/go/:slug",
      "destination": "https://app.imonsocial.com/api/go/:slug",
      "permanent": false
    },
    {
      "source": "/get/:code",
      "destination": "https://app.imonsocial.com/api/get/:code",
      "permanent": false
    },
    {
      "source": "/relationship-os",
      "destination": "/",
      "permanent": true
    }
  ]
}
