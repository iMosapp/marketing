# i'M On Social (IMOS) - repository ignore rules
# Keep this file intentional. Anything needed to recreate the app (source, configs, templates, docs) must NOT be ignored.

# ---------------------------------------------------------------- secrets & credentials
.env
.env.*
*.env
!.env.example
!**/.env.example
*.pem
*.p12
*.key
*.mobileprovision
*.keystore
*.jks
credentials.json
*credentials*.json
*token.json*
google-services.json
google-service-account.json
GoogleService-Info.plist
.credentials
memory/test_credentials.md

# ---------------------------------------------------------------- generated test output
test_reports/
test_result.md.bak
/coverage
.coverage
htmlcov/
.pytest_cache/
playwright-report/
test-results/

# ---------------------------------------------------------------- generated documents & media
backend/invoice_pdfs/
backend/exports/
*.pkpass

# ---------------------------------------------------------------- build artifacts
# NOTE: marketing/build and marketing/build-preview are intentionally TRACKED (Vercel serves marketing/build
# with no build step; the backend serves marketing/build-preview). Do not add them here until that changes.
frontend/dist/
frontend/web-build/
frontend/.expo/
frontend/.expo-shared/
frontend/.metro-cache/
frontend/ios/
frontend/android/
marketing/.vercel/
/build
/dist
*.tsbuildinfo
next-env.d.ts
/.next/
/out/

# ---------------------------------------------------------------- dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
venv/
.venv/

# ---------------------------------------------------------------- caches & temporary files
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.cache/
.eslintcache
.screenshots/
*.tmp
*.temp
*.swp
*.swo
*~
tmp/
temp/

# ---------------------------------------------------------------- logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# ---------------------------------------------------------------- local databases & dumps
dump.rdb
*.sqlite
*.sqlite3
*.db
data/db/
mongo_data/
dump/

# ---------------------------------------------------------------- OS files
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- IDE / editors
.idea/
.vscode/
*.code-workspace
.ipynb_checkpoints/

# ---------------------------------------------------------------- archives & large binaries that are not source
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
*.pack
*.deb
*.dylib

# ---------------------------------------------------------------- misc tooling
.vercel
chainlit.md
.chainlit
android-sdk/
