{
  "expo": {
    "name": "Im On Social",
    "slug": "imos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "imos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/178e2029-a577-4d78-9611-bd7ebec83c91",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "extra": {
      "backendUrl": "https://app.imonsocial.com",
      "appUrl": "https://app.imonsocial.com",
      "eas": {
        "projectId": "178e2029-a577-4d78-9611-bd7ebec83c91"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.imonsocial.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "I'm On Social uses your camera to take delivery photos with customers, capture profile photos, and create personalized congratulations cards. Photos are stored securely and used only for the contact records and cards you create.",
        "NSPhotoLibraryUsageDescription": "I'm On Social accesses your photo library so you can attach delivery photos to customer records, upload your profile picture, and add images to congratulations cards sent to customers.",
        "NSContactsUsageDescription": "I'm On Social imports your phone contacts so you can quickly add existing clients to your contact database, find customers by name or number, and start building relationships. Contact names, phone numbers, and emails are stored securely on our servers and used only for your relationship management activities.",
        "NSMicrophoneUsageDescription": "I'm On Social uses your microphone to record voice notes attached to customer records and to capture voice memos about sales interactions. Recordings are stored on our secure servers and associated only with the contact record you specify.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "app.imonsocial.com": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSExceptionRequiresForwardSecrecy": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.2",
              "NSIncludesSubdomains": true,
              "NSRequiresCertificateTransparency": false
            },
            "imonsocial.com": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSExceptionRequiresForwardSecrecy": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.2",
              "NSIncludesSubdomains": true,
              "NSRequiresCertificateTransparency": false
            }
          }
        }
      }
    },
    "android": {
      "package": "com.imonsocial.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_CONTACTS"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Im On Social to access your contacts to import them."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}