{
  "expo": {
    "name": "Im On Social",
    "slug": "imos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "imos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "backendUrl": "https://app.imonsocial.com",
      "appUrl": "https://app.imonsocial.com",
      "eas": {
        "projectId": "178e2029-a577-4d78-9611-bd7ebec83c91"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.imonsocial.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of contacts and for your profile",
        "NSPhotoLibraryUsageDescription": "Select photos for contacts, your profile, and cards",
        "NSContactsUsageDescription": "Import contacts from your address book to connect with clients",
        "NSMicrophoneUsageDescription": "Record voice notes and calls for contacts",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "app.imonsocial.com": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSExceptionRequiresForwardSecrecy": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.2",
              "NSIncludesSubdomains": true,
              "NSRequiresCertificateTransparency": false
            },
            "imonsocial.com": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSExceptionRequiresForwardSecrecy": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.2",
              "NSIncludesSubdomains": true,
              "NSRequiresCertificateTransparency": false
            }
          }
        }
      }
    },
    "android": {
      "package": "com.imonsocial.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_CONTACTS"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Im On Social to access your contacts to import them."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}