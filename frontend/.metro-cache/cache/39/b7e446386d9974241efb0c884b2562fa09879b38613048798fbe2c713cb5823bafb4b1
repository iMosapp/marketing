e = await api.post(`/tasks/${userId}`, data);\n      return response.data;\n    },\n    update: async (userId, taskId, data) => {\n      const response = await api.put(`/tasks/${userId}/${taskId}`, data);\n      return response.data;\n    },\n    patchTask: async (userId, taskId, data) => {\n      const response = await api.patch(`/tasks/${userId}/${taskId}`, data);\n      return response.data;\n    },\n    delete: async (userId, taskId) => {\n      const response = await api.delete(`/tasks/${userId}/${taskId}`);\n      return response.data;\n    }\n  };\n\n  // ============= AI API =============\n  const aiAPI = {\n    generateMessage: async (userId, context, intent) => {\n      const response = await api.post(`/ai/generate-message?user_id=${userId}&context=${encodeURIComponent(context)}&intent=${intent}`);\n      return response.data;\n    },\n    detectIntent: async message => {\n      const response = await api.post('/ai/detect-intent', {\n        message\n      });\n      return response.data;\n    }\n  };\n\n  // ============= ADMIN API =============\n  const adminAPI = {\n    // Organizations\n    createOrganization: async data => {\n      const response = await api.post('/admin/organizations', data);\n      return response.data;\n    },\n    listOrganizations: async () => {\n      const response = await api.get('/admin/organizations');\n      return response.data;\n    },\n    getOrganization: async orgId => {\n      const response = await api.get(`/admin/organizations/${orgId}`);\n      return response.data;\n    },\n    updateOrganization: async (orgId, data) => {\n      const response = await api.put(`/admin/organizations/${orgId}`, data);\n      return response.data;\n    },\n    deleteOrganization: async orgId => {\n      const response = await api.delete(`/admin/organizations/${orgId}`);\n      return response.data;\n    },\n    // Stores\n    createStore: async data => {\n      const response = await api.post('/admin/stores', data);\n      return response.data;\n    },\n    listStores: async orgId => {\n      const response = await api.get(`/admin/stores?organization_id=${orgId}`);\n      return response.data;\n    },\n    getStore: async storeId => {\n      const response = await api.get(`/admin/stores/${storeId}`);\n      return response.data;\n    },\n    updateStore: async (storeId, data) => {\n      const response = await api.put(`/admin/stores/${storeId}`, data);\n      return response.data;\n    },\n    deleteStore: async storeId => {\n      const response = await api.delete(`/admin/stores/${storeId}`);\n      return response.data;\n    },\n    // Users (Admin)\n    createUser: async data => {\n      const response = await api.post('/admin/users', data);\n      return response.data;\n    },\n    listOrgUsers: async (orgId, storeId, role) => {\n      const params = {};\n      if (storeId) params.store_id = storeId;\n      if (role) params.role = role;\n      const response = await api.get(`/admin/organizations/${orgId}/users`, {\n        params\n      });\n      return response.data;\n    },\n    updateUser: async (userId, data) => {\n      const response = await api.put(`/admin/users/${userId}`, data);\n      return response.data;\n    },\n    deleteUser: async userId => {\n      const response = await api.delete(`/admin/users/${userId}`);\n      return response.data;\n    },\n    // Stats\n    getStats: async orgId => {\n      const params = orgId ? {\n        org_id: orgId\n      } : {};\n      const response = await api.get('/admin/stats', {\n        params\n      });\n      return response.data;\n    },\n    // Leaderboard\n    getLeaderboard: async (orgId, storeId, metric) => {\n      const params = {};\n      if (storeId) params.store_id = storeId;\n      if (metric) params.metric = metric;\n      const response = await api.get(`/admin/organizations/${orgId}/leaderboard`, {\n        params\n      });\n      return response.data;\n    },\n    // Regional Leaderboard (Independents)\n    getRegionalLea