t api.get(`/templates/${userId}/categories/list`);\n      return response.data;\n    }\n  };\n\n  // ============= TAGS API =============\n  const tagsAPI = {\n    getAll: async userId => {\n      const response = await api.get(`/tags/${userId}`);\n      return response.data;\n    },\n    getPending: async userId => {\n      const response = await api.get(`/tags/${userId}/pending`);\n      return response.data;\n    },\n    create: async (userId, tag) => {\n      const response = await api.post(`/tags/${userId}`, tag);\n      return response.data;\n    },\n    approve: async (userId, tagId) => {\n      const response = await api.post(`/tags/${userId}/approve/${tagId}`);\n      return response.data;\n    },\n    reject: async (userId, tagId) => {\n      const response = await api.post(`/tags/${userId}/reject/${tagId}`);\n      return response.data;\n    },\n    update: async (userId, tagId, tag) => {\n      const response = await api.put(`/tags/${userId}/${tagId}`, tag);\n      return response.data;\n    },\n    delete: async (userId, tagId) => {\n      const response = await api.delete(`/tags/${userId}/${tagId}`);\n      return response.data;\n    },\n    getColors: async userId => {\n      const response = await api.get(`/tags/${userId}/colors`);\n      return response.data;\n    },\n    assignToContacts: async (userId, tagName, contactIds) => {\n      const response = await api.post(`/tags/${userId}/assign`, {\n        tag_name: tagName,\n        contact_ids: contactIds\n      });\n      return response.data;\n    },\n    removeFromContacts: async (userId, tagName, contactIds) => {\n      const response = await api.post(`/tags/${userId}/remove`, {\n        tag_name: tagName,\n        contact_ids: contactIds\n      });\n      return response.data;\n    },\n    getContactsByTag: async (userId, tagName) => {\n      const response = await api.get(`/tags/${userId}/contacts/${encodeURIComponent(tagName)}`);\n      return response.data;\n    }\n  };\n\n  // ============= SEARCH API =============\n  const searchAPI = {\n    globalSearch: async (userId, query, types, limit) => {\n      const params = {\n        q: query\n      };\n      if (types && types.length > 0) params.types = types.join(',');\n      if (limit) params.limit = limit;\n      const response = await api.get(`/search/${userId}`, {\n        params\n      });\n      return response.data;\n    },\n    getSuggestions: async (userId, query, limit) => {\n      const params = {\n        q: query\n      };\n      if (limit) params.limit = limit;\n      const response = await api.get(`/search/${userId}/suggestions`, {\n        params\n      });\n      return response.data;\n    }\n  };\n\n  // ============= EMAIL API =============\n  const emailAPI = {\n    // Send email\n    send: async (userId, data) => {\n      const response = await api.post(`/email/send?user_id=${userId}`, data);\n      return response.data;\n    },\n    // Email Templates\n    getTemplates: async userId => {\n      const response = await api.get(`/email/templates/${userId}`);\n      return response.data;\n    },\n    createTemplate: async (userId, template) => {\n      const response = await api.post(`/email/templates/${userId}`, template);\n      return response.data;\n    },\n    updateTemplate: async (userId, templateId, template) => {\n      const response = await api.put(`/email/templates/${userId}/${templateId}`, template);\n      return response.data;\n    },\n    deleteTemplate: async (userId, templateId) => {\n      const response = await api.delete(`/email/templates/${userId}/${templateId}`);\n      return response.data;\n    },\n    // Email Campaigns\n    getCampaigns: async userId => {\n      const response = await api.get(`/email/campaigns/${userId}`);\n      return response.data;\n    },\n    createCampaign: async (userId, campaign) => {\n      const response = await api.post(`/email/campaigns/${userId}`, campaign);\n      return response.data;\n    },\n    updateCampaign: async (userId, 