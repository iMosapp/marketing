# =====================================================================================================
# i'M On Social (IMOS) - frontend (Expo) environment template
# Copy to frontend/.env. NEVER commit frontend/.env. Only EXPO_PUBLIC_* values are bundled into the app.
#
# IMPORTANT: EXPO_PUBLIC_* values are baked into every `eas update` / `eas build` bundle. Point them at
# production (https://app.imonsocial.com) before publishing an OTA update; eas.json also forces the two URL
# values for the "production" build profile.
# =====================================================================================================

# ------------------------------------------------------------------------------- app URLs
# [REQUIRED on native] Backend origin for iOS/Android (the web build always calls the same-origin /api).
# Resolution order in services/api.ts: this var -> app.json extra.backendUrl -> https://app.imonsocial.com
# dev: your preview/tunnel URL when testing the native app against preview. prod: https://app.imonsocial.com
EXPO_PUBLIC_BACKEND_URL=https://app.imonsocial.com

# [REQUIRED] Public web URL used for share links, QR codes, guide/card links shown in the app.
# prod: https://app.imonsocial.com
EXPO_PUBLIC_APP_URL=https://app.imonsocial.com

# [OPTIONAL] Legacy alias read in one screen (partner agreement W-9 download). Default: same origin.
EXPO_PUBLIC_API_URL=

# ------------------------------------------------------------------------------- web push
# [REQUIRED for browser push] Must equal backend VAPID_PUBLIC_KEY.
EXPO_PUBLIC_VAPID_KEY=

# ------------------------------------------------------------------------------- payments
# [OPTIONAL] Stripe publishable key for in-app payment elements. Empty = payment UI hidden/disabled.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------- Metro / tooling
# [OPTIONAL] Where Metro keeps its file cache. Default: frontend/.metro-cache
METRO_CACHE_ROOT=

# =====================================================================================================
# EMERGENT PREVIEW-ONLY variables (present in the Emergent pod's frontend/.env; NOT needed elsewhere).
# They are read by ~19 admin screens as a fallback for the API origin and by the Emergent dev tooling.
# =====================================================================================================
# [EMERGENT] Preview pod public URL. Also read by backend/tests/_http.py to find the API under test.
REACT_APP_BACKEND_URL=
# [EMERGENT] Webpack dev-server socket port behind the preview proxy.
WDS_SOCKET_PORT=443
# [EMERGENT] Enables the platform health-check dev plugin (frontend/plugins/health-check).
ENABLE_HEALTH_CHECK=false
# [EMERGENT] Expo tunnel / packager settings for the preview proxy.
EXPO_TUNNEL_SUBDOMAIN=
EXPO_PACKAGER_HOSTNAME=
EXPO_PACKAGER_PROXY_URL=
EXPO_USE_FAST_RESOLVER=1
