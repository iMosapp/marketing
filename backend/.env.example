# =====================================================================================================
# i'M On Social (IMOS) - backend environment template
# Copy to backend/.env and fill in real values. NEVER commit backend/.env. Placeholders only in this file.
#
# Legend per variable:  [REQUIRED | OPTIONAL | EMERGENT | TEST-ONLY]
#   dev   = behaviour in a local / preview environment
#   stage = behaviour in a staging environment (none exists today; treat like production with test keys)
#   prod  = behaviour in production (app.imonsocial.com)
# See docs/DEPLOYMENT.md and docs/PORTABILITY.md for the full matrix.
# =====================================================================================================

# ------------------------------------------------------------------------------- core
# [REQUIRED] MongoDB connection string. dev: local mongod (mongodb://localhost:27017). prod: managed cluster
# (currently injected by Emergent at deploy). NOTE: services/runtime_env.is_preview_runtime() treats any URL
# containing "localhost"/"127.0.0.1" as PREVIEW and switches on the safety guards below (SMS allowlist,
# widget ring dry-run, no Twilio number purchases).
MONGO_URL=mongodb://localhost:27017

# [REQUIRED] Database name (used when MONGO_URL has no database path). Keep separate names per environment.
DB_NAME=imos_dev

# [REQUIRED] HMAC secret for JWT (HS256) and impersonation tokens. The server refuses to start auth without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))". Rotating it logs every user out.
JWT_SECRET=change-me-to-a-long-random-string

# [OPTIONAL] Comma-separated browser origins allowed by CORS. Default "*". *.imonsocial.com is always trusted.
# prod: "https://app.imonsocial.com". dev: "*".
CORS_ORIGINS=*

# [REQUIRED] Public base URL of THIS backend/web app (links in texts, Twilio webhooks, QR codes, guide URLs).
# dev: your preview/tunnel URL. prod: https://app.imonsocial.com
APP_URL=http://localhost:8001
# [OPTIONAL] Same as APP_URL; wins over APP_URL when set (legacy name still read in ~75 places).
PUBLIC_FACING_URL=

# [OPTIONAL] Domain used for shortened links (/s/{code}). Default: derived from APP_URL. prod: imonsocial.com
SHORT_URL_DOMAIN=
# [OPTIONAL] Base for "get the app" deep links. Default https://imonsocial.com/get
APP_LINK_BASE=
# [OPTIONAL] Marketing site URL used in emails/onboarding. Default https://www.imonsocial.com
MARKETING_SITE_URL=
# [OPTIONAL] Google Play listing URL once the Android app is published (empty -> marketing site).
PLAY_STORE_URL=

# ------------------------------------------------------------------------------- platform accounts
# [OPTIONAL] Email of the super admin who owns the platform Twilio number (startup assigns TWILIO_PHONE_NUMBER
# to this user; falls back to the oldest super_admin). Also receives signup alerts.
ADMIN_EMAIL=admin@example.com
# [OPTIONAL] Where sales/demo-request notifications go. Default: ADMIN_EMAIL.
SALES_EMAIL=sales@example.com
# [OPTIONAL] Reply-to for scheduled report emails. Default support@imonsocial.com
REPORT_REPLY_TO=
# [OPTIONAL] User id whose Twilio number sends Jessi onboarding texts. Default: ADMIN_EMAIL's user.
ONBOARDING_SENDER_USER_ID=

# ------------------------------------------------------------------------------- email (Resend)
# [REQUIRED for any email] Resend API key. dev: a test key or leave empty (emails are skipped/logged).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# [REQUIRED for any email] Verified sender. prod: noreply@imonsocial.com
SENDER_EMAIL=noreply@example.com
# [OPTIONAL] Resend inbound webhook signing secret (Svix "whsec_..."). Empty = signature not verified.
RESEND_WEBHOOK_SECRET=
# [OPTIONAL] Receiving domain for covert Lead Shops (MX + Resend receiving). Empty = Lead Shops disabled
# with a banner in the UI. prod: a neutral domain, e.g. mail.example-neutral.com
INBOUND_EMAIL_DOMAIN=
# [OPTIONAL] Sending domain for Lead Shop emails (hides the IMOS brand). Default: SENDER_EMAIL's domain.
LEAD_SENDER_DOMAIN=
# [OPTIONAL] Domain for mystery-shop email shops. Default: SENDER_EMAIL's domain.
SHOP_EMAIL_DOMAIN=

# ------------------------------------------------------------------------------- Twilio (SMS / voice)
# [REQUIRED for texting/calls] Platform account credentials. dev: your own test account.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# [REQUIRED for texting/calls] Platform number in E.164. Assigned to ADMIN_EMAIL's user at startup.
TWILIO_PHONE_NUMBER=+15005550006
# [OPTIONAL] Messaging Service SID for A2P 10DLC sending. Empty = send from TWILIO_PHONE_NUMBER directly.
TWILIO_MESSAGING_SERVICE_SID=
# [OPTIONAL] Number mystery shops call from. Default: TWILIO_PHONE_NUMBER (also settable in Admin UI).
MYSTERY_SHOP_FROM_NUMBER=
# [OPTIONAL] Webhook signature handling: "log" (default, mismatches logged only) or "enforce" (403 on bad signature).
# Turn on "enforce" in prod only after confirming no [TwilioSig] warnings in the logs.
TWILIO_WEBHOOK_VALIDATION=log
# [OPTIONAL] Secret for signed Twilio callback tokens. Default: JWT_SECRET.
TWILIO_TOKEN_KEY=
# [OPTIONAL] Trust Hub policy SIDs for A2P/CNAM/customer profiles (Twilio-global defaults are built in).
TWILIO_TRUSTHUB_A2P_POLICY=
TWILIO_TRUSTHUB_CNAM_POLICY=
TWILIO_TRUSTHUB_CUSTOMER_POLICY=
# [OPTIONAL] Texting-compliance emails. Defaults: empty notify address, sender name "Forest".
COMPLIANCE_NOTIFY_EMAIL=
COMPLIANCE_SENDER_NAME=
# [UNUSED] Present in older .env files; no code reads it. Safe to omit.
TWILIO_MOCK_MODE=

# ------------------------------------------------------------------------------- preview-only safety guards
# These ONLY take effect when is_preview_runtime() is true (MONGO_URL points at localhost). In production they are
# ignored, but assume every key here reaches the production environment on Deploy.
# [OPTIONAL] Comma-separated numbers/prefixes that may receive real SMS in preview; everything else is mocked.
SMS_SEND_ONLY_TO=+1500555
# [OPTIONAL] "true" = website-widget "Call me now" never rings a real phone in preview.
WIDGET_RING_DRY_RUN=true
# [OPTIONAL] "false" = never buy Twilio numbers for Lead Shops in preview (uses seeded pool rows instead).
LEAD_SHOP_BUY_NUMBERS=false

# ------------------------------------------------------------------------------- AI
# [REQUIRED for GPT-Live voice] Your own OpenAI key. Used ONLY by realtime voice (Jessi Live, live shop calls,
# host, interview, voice samples) via wss://api.openai.com/v1/live/sessions. Empty = those features return 503
# with a clear reason and fall back to Twilio ConversationRelay where possible.
OPENAI_API_KEY=
# [EMERGENT] Emergent universal LLM key. Powers ALL text AI (gpt-5.2 / gpt-4o-mini via emergentintegrations
# LlmChat), Whisper transcription and TTS. Not obtainable outside Emergent. See docs/PORTABILITY.md.
EMERGENT_LLM_KEY=
# [EMERGENT] Key for Emergent Object Storage (photos, voice notes, cards, PDFs). Falls back to EMERGENT_LLM_KEY.
# Pin it so rotating the LLM key never changes the storage namespace.
OBJECT_STORAGE_KEY=
# [OPTIONAL] Local disk cache cap (MB) for images fetched from object storage. Default 200.
IMAGE_CACHE_MB=

# ------------------------------------------------------------------------------- Stripe
# [EMERGENT] Key for emergentintegrations StripeCheckout (subscriptions, quotes, partner billing checkout).
# On Emergent the value "sk_test_emergent" routes through Emergent's Stripe test proxy. A real key also works.
STRIPE_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# [OPTIONAL] Your own Stripe secret key, used directly by the stripe SDK for mystery-shop proposals/invoices.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# [OPTIONAL] Stripe webhook signing secret for /api/webhook/stripe.
STRIPE_WEBHOOK_SECRET=
# [UNUSED by backend code] Kept for reference; the frontend reads its own EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY.
STRIPE_PUBLISHABLE_KEY=
STRIPE_ACCOUNT_ID=
STRIPE_MODE=test

# ------------------------------------------------------------------------------- push notifications
# [REQUIRED for web push] VAPID key pair (pywebpush). Generate: `vapid --gen` or web-push generate-vapid-keys.
# The public key must also be set as EXPO_PUBLIC_VAPID_KEY in frontend/.env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@example.com

# ------------------------------------------------------------------------------- Apple / Google Wallet passes
# [OPTIONAL] Apple Wallet .pkpass signing. All five required together; endpoint returns 503 until set.
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=
APPLE_PASS_P12_B64=
APPLE_PASS_P12_PASSWORD=
APPLE_WWDR_PEM_B64=
# [OPTIONAL] Google Wallet save links. Service-account JSON, base64 encoded.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_JSON_B64=

# ------------------------------------------------------------------------------- Google Calendar (OAuth)
# [OPTIONAL] Not configured in any environment today; the calendar router falls back to built-in defaults.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# ------------------------------------------------------------------------------- voice identity (Picovoice Eagle)
# [OPTIONAL] Enables speaker verification for voice interviews. Empty = feature reports "not configured".
PICOVOICE_ACCESS_KEY=
# [OPTIONAL] Match threshold 0..1. Default 0.6
VOICE_ID_THRESHOLD=

# ------------------------------------------------------------------------------- login hardening
# [OPTIONAL] Failed logins before lockout (default 8) and lockout length in minutes (default 15).
LOGIN_MAX_FAILS=
LOGIN_LOCKOUT_MINUTES=
# [OPTIONAL] Password-reset requests per IP (default 5) per window in minutes (default 15).
RESET_IP_MAX=
RESET_IP_WINDOW_MIN=

# ------------------------------------------------------------------------------- test-only (read by backend/tests/*, never by the server)
# Credentials for the QA accounts the test-suite logs in with. Tests fall back to literals when unset (see
# docs/PORTABILITY.md, "Test credentials"). Set them in your shell, not in production.
TEST_API_URL=http://localhost:8001
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASS=
TEST_USER_PASS=
TEST_SALES_PASS=
TEST_PARTNER_PASS=
TEST_OLD_PASS=
TEST_NEW_PASS=
TEST_CRM_TOKEN=
LADDER_QA_KEEP=
